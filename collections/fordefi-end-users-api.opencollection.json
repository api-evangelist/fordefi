{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fordefi Address Book End Users API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "End Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List End Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fordefi.com/api/v1/end-users",
            "params": [
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "include_count",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to fetch."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              },
              {
                "name": "skip_count",
                "value": "",
                "type": "query",
                "description": "Whether to skip counting the total number of items."
              },
              {
                "name": "user_ids",
                "value": "",
                "type": "query",
                "description": "The unique identifiers of the users."
              },
              {
                "name": "external_ids",
                "value": "",
                "type": "query",
                "description": "The external IDs of the users."
              }
            ]
          },
          "docs": "Get a list of end users in the organization."
        },
        {
          "info": {
            "name": "Create End User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fordefi.com/api/v1/end-users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new end user."
        },
        {
          "info": {
            "name": "Get Current End User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fordefi.com/api/v1/end-users/current"
          },
          "docs": "Gets the current end user."
        },
        {
          "info": {
            "name": "Get End User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fordefi.com/api/v1/end-users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the end user to retrieve."
              }
            ]
          },
          "docs": "Gets the end user that corresponds to the given ID."
        },
        {
          "info": {
            "name": "Delete End User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.fordefi.com/api/v1/end-users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the end user to delete."
              }
            ]
          },
          "docs": "Delete an end user."
        },
        {
          "info": {
            "name": "Set Export End User Keys Permissions",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.fordefi.com/api/v1/end-users/:id/set-export-end-user-keys-permissions",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the end user to allow export."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Allow or disable export of a keyset for an end user."
        }
      ]
    }
  ],
  "bundled": true
}