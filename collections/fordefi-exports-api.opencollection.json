{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fordefi Address Book Exports API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Exports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Export",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fordefi.com/api/v1/exports/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the export to retrieve."
              }
            ]
          },
          "docs": "Get an export by ID"
        },
        {
          "info": {
            "name": "Abort Export",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fordefi.com/api/v1/exports/:id/abort",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the export to abort."
              }
            ]
          },
          "docs": "Abort an export by ID"
        }
      ]
    }
  ],
  "bundled": true
}