{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fordefi Address Book Webhooks API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Test Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fordefi.com/api/v1/webhooks/test",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Test a webhook."
        },
        {
          "info": {
            "name": "Trigger Transaction Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fordefi.com/api/v1/webhooks/trigger/transaction/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the transaction to send events for."
              }
            ]
          },
          "docs": "Trigger transaction create and latest state via webhooks."
        },
        {
          "info": {
            "name": "Trigger Audit Log Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fordefi.com/api/v1/webhooks/trigger/audit-log/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the audit log record to send events for."
              }
            ]
          },
          "docs": "Trigger audit log record delivery via webhooks."
        }
      ]
    }
  ],
  "bundled": true
}