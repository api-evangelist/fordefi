{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fordefi Address Book User Groups API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List User Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fordefi.com/api/v1/user-groups",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to fetch."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              },
              {
                "name": "skip_count",
                "value": "",
                "type": "query",
                "description": "Whether to skip counting the total number of items."
              },
              {
                "name": "states",
                "value": "",
                "type": "query"
              },
              {
                "name": "user_group_ids",
                "value": "",
                "type": "query"
              },
              {
                "name": "user_ids",
                "value": "",
                "type": "query"
              },
              {
                "name": "modified_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "exclude_user_group_ids",
                "value": "",
                "type": "query",
                "description": "The group IDs to exclude."
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get a list of user groups"
        },
        {
          "info": {
            "name": "Get User Group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fordefi.com/api/v1/user-groups/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the user group to retrieve."
              }
            ]
          },
          "docs": "Retrieve user group details"
        }
      ]
    }
  ],
  "bundled": true
}